# Loops.so API Configuration
# Get your API key from https://app.loops.so/settings?page=api
LOOPS_API_KEY=your_loops_api_key_here

# Loops.so List ID from https://app.loops.so/contacts (optional)
# If provided, contacts will be added to this specific mailing list
LOOPS_LIST_ID=your_list_id_here

# Loops.so List ID for hero AI-agent demo leads (optional)
# Kept separate from LOOPS_LIST_ID so demo leads don't receive waitlist campaigns.
# If unset, the contact is still created — just not added to any mailing list.
LOOPS_AGENT_LIST_ID=your_agent_demo_list_id_here

# Loops.so List ID for teachers ambassador program applicants (optional)
# Kept separate so applicants don't receive student-facing campaigns.
# If unset, the contact is still created — just not added to any mailing list.
LOOPS_AMBASSADOR_LIST_ID=your_ambassador_list_id_here

# Loops.so List ID for creator (affiliate) program applicants (optional)
# Kept separate so creators don't receive teacher- or student-facing campaigns.
# If unset, the contact is still created — just not added to any mailing list.
LOOPS_CREATOR_LIST_ID=your_creator_list_id_here

# Notion — where ambassador and creator applications are reviewed.
# Internal integration secret from https://www.notion.so/my-integrations
# The integration must also be added to the database under "Content access".
# If unset, applications still reach Loops; nothing is written to Notion.
NOTION_TOKEN=ntn_your_internal_integration_secret_here
# 32-hex id from the database URL: notion.so/<workspace>/<id>?v=...
NOTION_APPLICATIONS_DB_ID=your_database_id_here

# Notion — where teacher discovery survey responses land.
# A separate database from the applications one: the schema is a column per
# question, so answers stay filterable instead of collapsing into free text.
# Create it with: node scripts/setup-teacher-survey.mjs <notion-parent-page-id>
# If unset, responses still reach Loops; nothing is written to Notion.
NOTION_TEACHER_SURVEY_DB_ID=your_survey_database_id_here

# Slack incoming webhook pinged on each new application (optional).
# Carries name, program and audience only — the rest stays behind the Notion link.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
